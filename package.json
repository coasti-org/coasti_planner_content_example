{
  "name": "cp-example-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check:py": "ruff check . && ruff format --check . && mypy",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm check:py",
    "fix:py": "ruff check --fix . && ruff format .",
    "fix": "pnpm lint:fix && pnpm format && pnpm fix:py"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "antd": "^6.6.5",
    "mermaid": "^12.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@coasti/planner-contract": "0.2.2",
    "@coasti/planner-ui": "0.2.2",
    "@module-federation/vite": "^1.23.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "js-yaml": "^5.4.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@11.27.0"
}
