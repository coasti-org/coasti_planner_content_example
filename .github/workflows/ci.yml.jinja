{% raw %}name: CI

# Shipped to generated projects. The template repository runs its own pipeline
# from .github/workflows/template-ci.yml: it renders this project first, then
# runs the checks through the same .github/actions/ setup steps.

on:
  pull_request:
  push:
    branches:
      - "**"
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  checks:
    name: Checks
    runs-on: ubuntu-latest
    timeout-minutes: 25
    steps:
      - name: Check out project
        uses: actions/checkout@v4

      - name: Setup frontend
        uses: ./.github/actions/setup-frontend
        with:
          working-directory: .
          registry-token: ${{ secrets.REGISTRY_RO_TOKEN }}

      - name: Setup backend
        uses: ./.github/actions/setup-backend
        with:
          working-directory: .

      - name: Check quality
        run: pnpm check

      - name: Build extension
        run: pnpm build{% endraw %}
